{
  "manifest_version": 3,
  "name": "Fokus Browser Tracker",
  "description": "Reports the active tab URL and title to the Fokus desktop app for accurate time tracking.",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
